# The house Wi-Fi's RADIUS server: EAP-TLS only, every decision from the device registry
# (view radius.valid_cert, through check-eap-tls). Authentik is never asked, so Wi-Fi works while it
# is down. Wired 802.1X will use the same path; MAC authentication (wired devices without
# 802.1X) gets its own elsif branch here later (docs: NETWORK-ACCESS.md).
#
# Fail closed, written positively (see check-eap-tls): access only inside an "if" whose test
# is true; every error or missing value ends in an else that rejects.
#
# Fail open for logging (netportal docs/TELEMETRY.md): logins, rejects and accounting are
# written through the registry's functions radius.login, radius.reject and radius.accounting,
# each as a %{sql_log:...} expansion in the TEST of an "if". sql_log (mods/sql_log) is a second
# rlm_sql instance with its own small pool and a 1 s query timeout: a slow or blocked write waits
# there, never for a connection of the decision's pool (mods/sql, used by check-eap-tls only). A failed expansion (database down,
# function missing, no right) is logged by rlm_sql and makes that test false without changing
# the section's result (a failed post-auth would turn an Accept into a Reject). 3.2.10 also
# lets a failed expansion inside "update" through as an empty value (tested 2026-10-25), but
# this does not depend on it. So no write can change a decision; the integration test revokes
# the functions and stops the database to show it.
# Values are escaped by rlm_sql (its default: characters outside safe_characters become =XX),
# inside '...' literals; the functions validate every argument.
#
# Rust port (rust/radius/, rust/docs/RADIUS_CONTRACT.md): the only changes are the three function
# names, radius_login -> radius.login, radius_reject -> radius.reject, radius_accounting ->
# radius.accounting (schema radius, schema-qualified), and these comments. Argument lists, their
# order, the escaping, the Class pattern and every if/else are exactly radius/sites/default's.
server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}
	listen {
		type = acct
		ipaddr = *
		port = 1813
	}

	authorize {
		if (&EAP-Message) {
			eap
		}
		else {
			reject
		}
	}

	authenticate {
		Auth-Type eap {
			eap
		}
	}

	accounting {
		# UniFi sends Start, Interim-Update (Acct-Interim-Interval), Stop and Accounting-On/Off;
		# radius.accounting keeps one row per NAS session (radius_acct). Class echoes the token
		# of the login (radius.login); Event-Timestamp as epoch seconds. Always answered: a
		# write that fails is logged and the access point does not retransmit.
		# Rust port: radius.accounting (was radius_accounting), the same 14 arguments.
		if ("%{sql_log:SELECT radius.accounting('%{Acct-Status-Type}', '%{Acct-Session-Id}', '%{Class}', '%{Calling-Station-Id}', '%{Called-Station-Id}', '%{%{NAS-IP-Address}:-%{Packet-Src-IP-Address}}', '%{Framed-IP-Address}', '%{Acct-Session-Time}', '%{Acct-Input-Octets}', '%{Acct-Output-Octets}', '%{Acct-Input-Gigawords}', '%{Acct-Output-Gigawords}', '%{Acct-Terminate-Cause}', '%{integer:Event-Timestamp}')}") {
			noop
		}
		ok
	}

	post-auth {
		# VLAN and device were decided by check-eap-tls (outer.control).
		if (&control:Tmp-String-0 && (&control:Tmp-String-0 =~ /^[0-9]+$/)) {
			update reply {
				&Tunnel-Type := VLAN
				&Tunnel-Medium-Type := IEEE-802
				&Tunnel-Private-Group-Id := "%{control:Tmp-String-0}"
				# Backstop for sessions a Disconnect-Request does not reach (netaccess.session_timeout).
				&Session-Timeout := $ENV{RADIUS_SESSION_TIMEOUT}
				&Termination-Action := RADIUS-Request
				# Accounting Interim-Update interval (hostapd takes it from the Accept): traffic
				# and presence per session even when the controller's own interval differs. The
				# portal reads the same NETPORTAL_ACCT_INTERIM_S (a session silent for 2 x this +
				# 60 s is abandoned); radius/entrypoint.sh defaults it to 300.
				&Acct-Interim-Interval := $ENV{NETPORTAL_ACCT_INTERIM_S}
			}
			# The login (radius_auth), the device's MAC identity (device_mac) and its latest
			# session (radius_session: where netportal sends the Disconnect-Request when the
			# device is revoked; without NAS-IP-Address the packet's source is the access point;
			# first_seen kept while the MAC stays). The returned token goes into Class, which
			# the access point echoes in accounting (radius_acct link "class"). Only after the
			# decision, and only into the test of an "if" (see the top).
			# Rust port: radius.login (was radius_login), the same 7 arguments.
			if (&control:Tmp-String-2 && (&control:Tmp-String-2 =~ /^[-0-9a-f]+$/)) {
				if ("%{sql_log:SELECT radius.login('%{control:Tmp-String-2}', '%{TLS-Client-Cert-Serial}', '%{Calling-Station-Id}', '%{Called-Station-Id}', '%{%{NAS-IP-Address}:-%{Packet-Src-IP-Address}}', '%{Acct-Session-Id}', '%{User-Name}')}" =~ /^(np1:[-_0-9A-Za-z]{22})$/) {
					update reply {
						&Class := "%{1}"
					}
				}
			}
		}
		else {
			reject
		}
		Post-Auth-Type REJECT {
			update reply {
				&Reply-Message := "device not registered"
			}
			# Every reject with its reason (radius_auth): with a client certificate whose chain
			# verified, the registry says why (unknown_cert, revoked, retired, expired; bad_chain
			# when it would accept the serial: check_cert_issuer refused it), else the hint:
			# bad_chain (a chain was presented but did not verify: only its CA certificates were
			# read, TLS-Cert-*), no_cert (EAP without a client certificate), not_eap.
			if (&TLS-Cert-Serial) {
				update control {
					&Tmp-String-4 := "bad_chain"
				}
			}
			elsif (&EAP-Message) {
				update control {
					&Tmp-String-4 := "no_cert"
				}
			}
			else {
				update control {
					&Tmp-String-4 := "not_eap"
				}
			}
			# Rust port: radius.reject (was radius_reject), the same 5 arguments.
			if ("%{sql_log:SELECT radius.reject('%{TLS-Client-Cert-Serial}', '%{Calling-Station-Id}', '%{Called-Station-Id}', '%{%{NAS-IP-Address}:-%{Packet-Src-IP-Address}}', '%{control:Tmp-String-4}')}") {
				noop
			}
		}
	}
}
