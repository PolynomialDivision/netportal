# The registry for LOGGING only (netportal docs/TELEMETRY.md, "fail open for logging"): the
# %{sql_log:...} expansions in sites/default that call radius.login, radius.reject and
# radius.accounting. A second instance of rlm_sql with its own small pool, so a slow or blocked
# log write (a row lock, a flood of rejects, a busy database) can only use up these connections,
# never the decision's (module "sql", mods/sql: SELECT on radius.valid_cert only). Same role and
# database as "sql" (role radius: EXECUTE on the functions of the schema radius, no table rights).
#
# Bounded on every side:
# - pool max 4: at most four requests wait on a log write at once; a fifth finds no free
#   connection and its expansion fails at once ("No connections available"), which the "if" in
#   sites/default turns into "not logged" (the decision is made already);
# - query_timeout 1 s: rlm_sql_postgresql gives up reading the answer after 1 s (and uses it as
#   libpq's connect_timeout), so a post-auth waits about a second at most before the reply goes
#   out; the functions themselves wait 500 ms for a row lock and the role has statement_timeout
#   2 s (rust/sql/radius_grants.sql), so a normal write is done in milliseconds;
# - max_retries 0: a timed-out or broken connection is replaced, but the write is not tried again
#   on the new one (that would multiply the wait); it is lost, as any failed log write.
#
# Rust port (rust/radius/): ONLY the comments changed (the contract's names: radius.login,
# radius.reject, radius.accounting, radius.valid_cert; rust/sql/radius_grants.sql). Every setting
# is exactly radius/mods/sql_log's.
sql sql_log {
	dialect = "postgresql"
	driver = "rlm_sql_${dialect}"
	server = "$ENV{RADIUS_DB_HOST}"
	port = 5432
	login = "radius"
	password = "$ENV{RADIUS_DB_PASSWORD}"
	radius_db = "$ENV{RADIUS_DB_NAME}"
	read_clients = no
	delete_stale_sessions = no
	query_timeout = 1
	postgresql {
		# application_name "FreeRADIUS <version> - radiusd (sql_log)": the integration test tells
		# the two pools apart by it.
		send_application_name = yes
	}
	# Opened on demand (unlike the decision's pool, mods/sql): a logging call that finds no free
	# connection only loses its row (a login without Class), and a pool that kept all four open
	# would retry them on every request while the database is gone, so accounting answers came
	# too late (integration test, database down). connect_timeout keeps a reconnect short.
	pool {
		start = 1
		min = 1
		max = 4
		spare = 1
		uses = 0
		retry_delay = 1
		max_retries = 0
		lifetime = 0
		idle_timeout = 60
		connect_timeout = 1.0
	}
}
