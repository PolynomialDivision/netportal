# The device registry (PostgreSQL) for the ACCESS DECISION: only the %{sql:...} expansions of
# sites/check-eap-tls (SELECT on the view radius.valid_cert; no RADIUS user or accounting tables).
# The logging calls (radius.login, radius.reject, radius.accounting) go through their own instance
# and pool, mods/sql_log, so no log write can take a connection the decision needs. Role
# "radius": USAGE on the schema radius, SELECT on its view valid_cert and EXECUTE on its four
# functions (sql/radius_grants.sql, docs/RADIUS_CONTRACT.md), nothing in public, no
# table rights. Values from requests are escaped with rlm_sql's default (auto_escape off: every
# character outside safe_characters becomes =XX), so no quote reaches the SQL text.
# The role has statement_timeout 2s (radius_grants.sql): a slow registry cannot hold up an answer.
#
# radius_db is the registry's database (house-infra sets RADIUS_DB_NAME).
sql {
	dialect = "postgresql"
	driver = "rlm_sql_${dialect}"
	server = "$ENV{RADIUS_DB_HOST}"
	port = 5432
	login = "radius"
	password = "$ENV{RADIUS_DB_PASSWORD}"
	radius_db = "$ENV{RADIUS_DB_NAME}"
	read_clients = no
	delete_stale_sessions = no
	# rlm_sql_postgresql passes this to libpq as connect_timeout (without it a database that is
	# unreachable, not refusing, holds every request in a TCP connect for minutes: the access
	# points then get no answer at all, also for accounting; found by the integration test's
	# outage case).
	query_timeout = 3
	postgresql {
		send_application_name = yes
	}
	# All connections open from the start (start = min = max): a pool that opens them on demand
	# fails a request that finds none free while one is still being opened, which here is a
	# reject; a burst of logins (every client of a restarted access point at once) hits that
	# (integration test: ten logins at once, 9 of 10 got in).
	pool {
		start = 8
		min = 8
		max = 8
		spare = 0
		uses = 0
		retry_delay = 1
		lifetime = 0
		idle_timeout = 60
		connect_timeout = 3.0
	}
}
