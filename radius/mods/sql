# The device registry (PostgreSQL). Role "radius": SELECT on radius_cert, write radius_session.
# Only the %{sql:...} expansion is used (no RADIUS user or accounting tables).
sql {
	dialect = "postgresql"
	driver = "rlm_sql_${dialect}"
	server = "$ENV{RADIUS_DB_HOST}"
	port = 5432
	login = "radius"
	password = "$ENV{RADIUS_DB_PASSWORD}"
	radius_db = "$ENV{RADIUS_DB_NAME}"
	read_clients = no
	delete_stale_sessions = no
	postgresql {
		send_application_name = yes
	}
	pool {
		start = 2
		min = 1
		max = 8
		spare = 2
		uses = 0
		retry_delay = 1
		lifetime = 0
		idle_timeout = 60
		connect_timeout = 3.0
	}
}
