# EAP: only EAP-TLS. No PEAP/MSCHAPv2, no TTLS/PAP: nothing on the air that a fake access
# point could phish or crack. TLS 1.3 is allowed so the client certificate is not visible to a
# passive listener (TLS 1.2 sends it in clear; it carries no personal data either way).
eap {
	default_eap_type = tls
	timer_expire = 60
	ignore_unknown_eap_types = no
	cisco_accounting_username_bug = no
	max_sessions = ${max_requests}

	tls-config tls-common {
		private_key_file = /run/netportal/radius-server.key   # copied by entrypoint.sh
		certificate_file = /etc/netportal/radius-server.pem
		# Client certificates must chain to the device CA (and the root above it); a certificate
		# the root signed directly (e.g. the server's own) is refused by check_cert_issuer.
		ca_file = /etc/netportal/device-ca-chain.pem
		check_cert_issuer = "$ENV{DEVICE_CA_DN}"
		tls_min_version = "1.2"
		tls_max_version = "1.3"
		cipher_list = "DEFAULT"
		cipher_server_preference = yes
		ecdh_curve = ""
		cache {
			enable = no
		}
		verify {
		}
		ocsp {
			enable = no
		}
	}

	tls {
		tls = tls-common
		# The registry decides per certificate (serial): unknown, revoked or expired -> reject.
		# It belongs HERE, in tls {}: inside tls-config it is ignored without a warning and every
		# validly signed certificate gets in (found by the PoC's "unregistered" case).
		virtual_server = check-eap-tls
	}
}
