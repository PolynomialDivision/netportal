# Called by the EAP-TLS module once the client certificate's chain is valid (once per
# authentication, just before the final Accept). The registry decides: the serial must belong
# to a device that is not revoked and not expired. The VLAN and device ID go to the outer
# request (outer.control), where post-auth builds the reply.
#
# Fail closed, written positively: access only inside an "if" whose test is true. In
# FreeRADIUS 3 a test on a missing attribute fails with an error and counts as false, also
# when negated, so "if (!(&x =~ ...)) { reject }" lets a missing value through (found by the
# PoC). Likewise an empty SQL result in an integer attribute becomes 0, which "exists".
#
# The decision view radius.valid_cert (docs/RADIUS_CONTRACT.md; schema-qualified although
# "$user" would resolve it): serial, device_id text, vlan integer; a serial whose device is a
# certificate device, not revoked, and whose credential is neither expired nor retired.
#
# Security review 2026-10-29 (L3): the certificate must also name the device the registry has
# for its serial: its subject CN is the device's NAI "<device id>@<realm>" (the portal's
# certificates, netportal_pki::pki::device_identity), and the decision asks for serial AND
# device id. A certificate the device CA signed with a registered serial but another identity
# (a registry or issuing mistake, or a forgery) is refused. FreeRADIUS 3.2 offers nothing derived
# from the certificate's key (no fingerprint attribute; the verify hook sees no serial, keeps
# no output and lets a certificate through when it cannot write its file), so whoever holds the
# device CA key AND knows a device's serial and id (both in the clear under TLS 1.2) can still
# make a certificate that gets in as that device: docs/RADIUS_CONTRACT.md "Residual risk".
server check-eap-tls {
	authorize {
		if (&TLS-Client-Cert-Serial && (&TLS-Client-Cert-Serial =~ /^[0-9a-fA-F]+$/)) {
			update request {
				&Tmp-String-1 := "%{tolower:%{TLS-Client-Cert-Serial}}"
			}
			# the device id from the certificate's own identity (lower-case UUID, as issued)
			if (&TLS-Client-Cert-Common-Name && (&TLS-Client-Cert-Common-Name =~ /^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})@[-.0-9a-z]+$/)) {
				update request {
					&Tmp-String-3 := "%{1}"
				}
			}
			if (&request:Tmp-String-3 && (&request:Tmp-String-3 =~ /^[-0-9a-f]{36}$/)) {
				update control {
					# radius.valid_cert by serial and device id
					&Tmp-String-0 := "%{sql:SELECT vlan FROM radius.valid_cert WHERE serial = '%{Tmp-String-1}' AND device_id = '%{request:Tmp-String-3}'}"
					&Tmp-String-2 := "%{sql:SELECT device_id FROM radius.valid_cert WHERE serial = '%{Tmp-String-1}' AND device_id = '%{request:Tmp-String-3}'}"
				}
			}
			if (&control:Tmp-String-0 && (&control:Tmp-String-0 =~ /^[0-9]+$/) && &control:Tmp-String-2 && (&control:Tmp-String-2 == &request:Tmp-String-3)) {
				update outer.control {
					&Tmp-String-0 := &control:Tmp-String-0
					&Tmp-String-2 := &control:Tmp-String-2
				}
				update control {
					&Auth-Type := Accept
				}
			}
			else {
				update control {
					&Auth-Type := Reject
				}
				reject
			}
		}
		else {
			update control {
				&Auth-Type := Reject
			}
			reject
		}
	}
}
